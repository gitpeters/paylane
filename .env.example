# Paylane local configuration — copy to `.env` (which is gitignored) and adjust.
# The defaults below match the `docker run` for Postgres in the README.
#
#   cp .env.example .env

# Database (JDBC). The dev/local Postgres listens on 5433 to avoid clashing with a system 5432.
PAYLANE_DB_URL=jdbc:postgresql://localhost:5433/paylane
PAYLANE_DB_USERNAME=postgres
PAYLANE_DB_PASSWORD=postgres

# HTTP port for the app (defaults to 8082 if unset).
SERVER_PORT=8082
